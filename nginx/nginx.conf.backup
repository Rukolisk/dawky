# nginx-init.conf — Config HTTP SEULEMENT
# Utilisée pour la 1ère installation avant d'avoir le certificat SSL

events { worker_connections 1024; }

http {
    server {
        listen 80;
        server_name dawky.fr www.dawky.fr;

        # Pour que Certbot puisse vérifier que vous possédez dawky.fr
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Proxy vers l'app pendant l'init
        location / {
            proxy_pass         http://app:3000;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_read_timeout 60s;
        }
    }
}
