// prisma/schema.prisma — Prisma 7
//
// Conventions :
//   - tous les montants sont en CENTIMES (Int) pour éviter les erreurs d'arrondi
//   - les mois sont au format "YYYY-MM"
//   - les tailles de box sont S (≤ 10 kg), M (≤ 25 kg), L (> 25 kg) ; les
//     seuils réels sont modifiables dans la table `reglages`

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Taille {
  S
  M
  L
}

enum NiveauActivite {
  FAIBLE
  MODERE
  ELEVE
}

enum Categorie {
  FRIANDISE
  MASTICATION
  JOUET
  ACCESSOIRE
}

// Présence d'un allergène dans un produit
enum PresenceAllergene {
  CONTIENT
  TRACES
}

enum StatutLot {
  DISPONIBLE // vendable (stock courant ou invendu)
  RETIRE     // retiré du site à J-30 de la date limite, à donner
  DONNE      // donné à une association
}

enum TypeFormule {
  SURPRISE    // abonnement mensuel
  SAISONNIERE // box ponctuelle, sans abonnement
  COMPOSE     // Compose ta box (lots invendus)
}

enum StatutBoxMensuelle {
  BROUILLON
  VALIDEE
  EXPEDIEE
  CLOTUREE
}

enum StatutAbonnement {
  EN_ATTENTE_PAIEMENT
  ACTIF
  PAUSE
  IMPAYE
  RESILIE // résiliation demandée, effective à `dateFin`
  TERMINE // plus aucune box ne sera envoyée
  ANNULE  // paiement initial jamais finalisé
}

enum StatutCadeau {
  EN_ATTENTE_PAIEMENT
  ACTIF
  TERMINE
  ANNULE
}

enum TypeCommande {
  BOX_MENSUELLE // envoi mensuel d'un abonnement ou d'un cadeau
  COMPOSE
  SAISONNIERE
}

enum StatutCommande {
  EN_ATTENTE_PAIEMENT
  PAYEE
  PREPAREE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum ModeLivraison {
  DOMICILE
  POINT_RELAIS
}

enum StatutAlerteAllergie {
  A_TRAITER
  CONTACTE
  VALIDEE
}

enum TypeReduction {
  POURCENTAGE
  MONTANT
}

enum StatutParrainage {
  EN_ATTENTE // filleul inscrit, pas encore payé
  VALIDE     // premier paiement du filleul effectué, récompense accordée
}

enum StatutAvis {
  EN_ATTENTE
  PUBLIE
  REFUSE
}

// ─── Utilisateurs et chiens ──────────────

model Client {
  id               String   @id @default(cuid())
  supabaseUid      String?  @unique
  email            String   @unique
  prenom           String
  nom              String
  telephone        String?
  role             Role     @default(USER)
  stripeCustomerId String?  @unique
  // Code personnel à partager (parrainage)
  codeParrainage   String   @unique
  // Réductions de parrainage gagnées, pas encore utilisées
  recompensesParrainage Int @default(0)
  anonymiseLe      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adresses          Adresse[]
  chiens            Chien[]
  abonnements       Abonnement[]
  cadeauxOfferts    AbonnementCadeau[]
  commandes         Commande[]
  contacts          Contact[]
  quizResults       QuizResult[]
  alertesStock      AlerteStock[]
  avis              Avis[]
  parrainages       Parrainage[]       @relation("Parrain")
  parrainePar       Parrainage?        @relation("Filleul")
  alertesTraitees   AlerteAllergie[]   @relation("AlerteTraiteePar")

  @@map("clients")
}

model Adresse {
  id         String   @id @default(cuid())
  clientId   String
  libelle    String?  // "Maison", "Chez ma fille"…
  prenom     String
  nom        String
  ligne1     String
  ligne2     String?
  codePostal String
  ville      String
  pays       String   @default("France")
  telephone  String?
  parDefaut  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  abonnements Abonnement[]

  @@index([clientId])
  @@map("adresses")
}

model Chien {
  id                   String         @id @default(cuid())
  clientId             String
  nom                  String
  race                 String?
  dateNaissance        DateTime?
  poids                Float
  // Taille calculée (poids + race), modifiable par le client
  taille               Taille
  niveauActivite       NiveauActivite @default(MODERE)
  estMacheur           Boolean        @default(false)
  comportement         String?
  sensibleTraces       Boolean        @default(false)
  // Allergies hors de la liste standard (texte libre)
  allergiesAutres      String?
  // Consentement RGPD sur les données du chien (obligatoire avant souscription)
  consentementRgpdLe   DateTime?
  // Profil sans allergènes validé par l'équipe après contact du client
  profilAllergieValide Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  allergenes      ChienAllergene[]
  abonnements     Abonnement[]
  alertesAllergie AlerteAllergie[]
  commandes       Commande[]

  @@index([clientId])
  @@map("chiens")
}

model Allergene {
  id   String @id @default(cuid())
  // Identifiant stable utilisé par le front et les filtres ("poulet", "boeuf"…)
  code String @unique
  nom  String

  chiens   ChienAllergene[]
  produits ProduitAllergene[]

  @@map("allergenes")
}

model ChienAllergene {
  chienId     String
  allergeneId String

  chien     Chien     @relation(fields: [chienId], references: [id], onDelete: Cascade)
  allergene Allergene @relation(fields: [allergeneId], references: [id], onDelete: Cascade)

  @@id([chienId, allergeneId])
  @@map("chien_allergenes")
}

// ─── Catalogue et stock ──────────────────

model Produit {
  id          String    @id @default(cuid())
  nom         String
  description String
  emoji       String    @default("📦")
  imageUrl    String?
  categorie   Categorie
  // Composition complète (obligatoire pour FRIANDISE / MASTICATION)
  ingredients String?
  // Prix unitaire dans Compose ta box (centimes)
  prix        Int       @default(0)
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tailles           ProduitTaille[]
  allergenes        ProduitAllergene[]
  lots              LotStock[]
  boxMensuelleItems BoxMensuelleItem[]
  selectionItems    SelectionItem[]

  @@map("produits")
}

model ProduitTaille {
  produitId String
  taille    Taille

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  @@id([produitId, taille])
  @@map("produit_tailles")
}

model ProduitAllergene {
  produitId   String
  allergeneId String
  presence    PresenceAllergene

  produit   Produit   @relation(fields: [produitId], references: [id], onDelete: Cascade)
  allergene Allergene @relation(fields: [allergeneId], references: [id], onDelete: Cascade)

  @@id([produitId, allergeneId])
  @@map("produit_allergenes")
}

// Stock d'un produit, découpé en lots.
//   moisOrigine = null    → stock courant, utilisé pour les box du mois
//   moisOrigine = "YYYY-MM" → lot invendu issu de la clôture de ce mois,
//                           proposé dans Compose ta box
model LotStock {
  id          String    @id @default(cuid())
  produitId   String
  quantite    Int
  dateLimite  DateTime?
  moisOrigine String?
  statut      StatutLot @default(DISPONIBLE)
  retireLe    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  produit        Produit         @relation(fields: [produitId], references: [id], onDelete: Cascade)
  selectionItems SelectionItem[]
  dons           Don[]

  @@index([produitId, statut])
  @@index([moisOrigine, statut])
  @@map("lots_stock")
}

model Don {
  id          String   @id @default(cuid())
  lotId       String
  quantite    Int
  association String
  note        String?
  donneLe     DateTime @default(now())

  lot LotStock @relation(fields: [lotId], references: [id])

  @@map("dons")
}

// ─── Box et prix ─────────────────────────

model FormulaBox {
  id             String      @id @default(cuid())
  slug           String      @unique
  nom            String
  description    String
  type           TypeFormule
  actif          Boolean     @default(true)
  // Box saisonnières : fenêtre de vente et stock de box disponibles
  dateDebutVente DateTime?
  dateFinVente   DateTime?
  stock          Int?
  // Contenu prévu par catégorie, sans révéler les produits
  // ex: { "S": { "JOUET": 1, "FRIANDISE": 2, … }, "M": {…}, "L": {…} }
  contenu        Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  prix        PrixTaille[]
  abonnements Abonnement[]
  commandes   Commande[]

  @@map("formules")
}

model PrixTaille {
  formulaId String
  taille    Taille
  prix      Int // centimes

  formula FormulaBox @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@id([formulaId, taille])
  @@map("prix_tailles")
}

// Contenu de la Box Surprise pour un mois et une taille
model BoxMensuelle {
  id             String             @id @default(cuid())
  mois           String
  taille         Taille
  theme          String?
  description    String?
  statut         StatutBoxMensuelle @default(BROUILLON)
  dateExpedition DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items     BoxMensuelleItem[]
  commandes Commande[]

  @@unique([mois, taille])
  @@map("box_mensuelles")
}

model BoxMensuelleItem {
  boxMensuelleId String
  produitId      String
  quantite       Int    @default(1)

  boxMensuelle BoxMensuelle @relation(fields: [boxMensuelleId], references: [id], onDelete: Cascade)
  produit      Produit      @relation(fields: [produitId], references: [id])

  @@id([boxMensuelleId, produitId])
  @@map("box_mensuelle_items")
}

// ─── Abonnements et commandes ────────────

model Abonnement {
  id                   String           @id @default(cuid())
  clientId             String
  chienId              String
  formulaId            String
  adresseId            String?
  taille               Taille
  // Prix figé à la souscription : un changement de tarif ne s'applique
  // qu'aux nouvelles souscriptions
  prixMensuel          Int
  statut               StatutAbonnement @default(EN_ATTENTE_PAIEMENT)
  modeLivraison        ModeLivraison    @default(DOMICILE)
  pointRelaisId        String?
  pointRelaisLibelle   String?
  dateDebut            DateTime?
  // Fin de la période payée en cours (mise à jour par les webhooks Stripe)
  finPeriode           DateTime?
  dateFin              DateTime?
  pauseJusquau         DateTime?
  raisonResiliation    String?
  stripeSubscriptionId String?          @unique
  stripeCheckoutId     String?          @unique
  codePromoId          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chien     Chien      @relation(fields: [chienId], references: [id])
  formula   FormulaBox @relation(fields: [formulaId], references: [id])
  adresse   Adresse?   @relation(fields: [adresseId], references: [id], onDelete: SetNull)
  codePromo CodePromo? @relation(fields: [codePromoId], references: [id])
  commandes Commande[]

  @@index([clientId])
  @@index([statut, taille])
  @@map("abonnements")
}

// Abonnement prépayé offert (X mois, sans reconduction)
model AbonnementCadeau {
  id                   String       @id @default(cuid())
  acheteurId           String
  taille               Taille
  dureeMois            Int
  prixMensuel          Int
  total                Int
  remise               Int          @default(0)
  statut               StatutCadeau @default(EN_ATTENTE_PAIEMENT)
  moisEnvoyes          Int          @default(0)
  // Destinataire
  destPrenom           String
  destNom              String
  destEmail            String?
  destLigne1           String
  destLigne2           String?
  destCodePostal       String
  destVille            String
  destPays             String       @default("France")
  destTelephone        String?
  nomChien             String?
  message              String?
  // Prévenir la destinataire par email (sans dévoiler le contenu)
  annoncer             Boolean      @default(false)
  annonceEnvoyeeLe     DateTime?
  rappelFinEnvoyeLe    DateTime?
  dateDebut            DateTime?
  stripeCheckoutId     String?      @unique
  codePromoId          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  acheteur  Client     @relation(fields: [acheteurId], references: [id])
  codePromo CodePromo? @relation(fields: [codePromoId], references: [id])
  commandes Commande[]

  @@index([statut])
  @@map("abonnements_cadeaux")
}

model Commande {
  id                 String         @id @default(cuid())
  numero             Int            @unique @default(autoincrement())
  type               TypeCommande
  clientId           String
  chienId            String?
  formulaId          String?
  abonnementId       String?
  cadeauId           String?
  boxMensuelleId     String?
  taille             Taille
  statut             StatutCommande @default(EN_ATTENTE_PAIEMENT)
  sousTotal          Int            @default(0)
  fraisPort          Int            @default(0)
  remise             Int            @default(0)
  total              Int            @default(0)
  // Adresse figée au moment de la commande
  modeLivraison      ModeLivraison  @default(DOMICILE)
  livNom             String
  livAdresse         String
  livCodePostal      String
  livVille           String
  livPays            String         @default("France")
  pointRelaisId      String?
  transporteur       String?
  numeroSuivi        String?
  dateExpedition     DateTime?
  dateLivraison      DateTime?
  stripeCheckoutId   String?        @unique
  stripeInvoiceId    String?
  factureUrl         String?
  codePromoId        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client       Client            @relation(fields: [clientId], references: [id])
  chien        Chien?            @relation(fields: [chienId], references: [id], onDelete: SetNull)
  formula      FormulaBox?       @relation(fields: [formulaId], references: [id])
  abonnement   Abonnement?       @relation(fields: [abonnementId], references: [id])
  cadeau       AbonnementCadeau? @relation(fields: [cadeauId], references: [id])
  boxMensuelle BoxMensuelle?     @relation(fields: [boxMensuelleId], references: [id])
  codePromo    CodePromo?        @relation(fields: [codePromoId], references: [id])
  selections   SelectionItem[]

  @@unique([abonnementId, boxMensuelleId])
  @@unique([cadeauId, boxMensuelleId])
  @@index([clientId])
  @@index([statut])
  @@map("commandes")
}

// Ligne d'une commande Compose ta box
model SelectionItem {
  id           String @id @default(cuid())
  commandeId   String
  produitId    String
  lotId        String
  quantite     Int    @default(1)
  prixUnitaire Int

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit  Produit  @relation(fields: [produitId], references: [id])
  lot      LotStock @relation(fields: [lotId], references: [id])

  @@map("selection_items")
}

// ─── Allergies et fidélisation ───────────

// Notification à l'équipe quand un chien abonné a des allergies
model AlerteAllergie {
  id           String               @id @default(cuid())
  chienId      String
  statut       StatutAlerteAllergie @default(A_TRAITER)
  note         String?
  traiteParId  String?
  traiteLe     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  chien     Chien   @relation(fields: [chienId], references: [id], onDelete: Cascade)
  traitePar Client? @relation("AlerteTraiteePar", fields: [traiteParId], references: [id], onDelete: SetNull)

  @@index([statut])
  @@map("alertes_allergie")
}

// "Prévenez-moi quand des produits compatibles reviennent"
model AlerteStock {
  id         String    @id @default(cuid())
  clientId   String
  taille     Taille
  notifieeLe DateTime?
  createdAt  DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, taille])
  @@map("alertes_stock")
}

model CodePromo {
  id              String        @id @default(cuid())
  code            String        @unique
  description     String?
  type            TypeReduction
  // Pourcentage (10 = 10 %) ou montant en centimes
  valeur          Int
  actif           Boolean       @default(true)
  dateDebut       DateTime?
  dateFin         DateTime?
  utilisationsMax Int?
  utilisations    Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  abonnements Abonnement[]
  cadeaux     AbonnementCadeau[]
  commandes   Commande[]

  @@map("codes_promo")
}

model Parrainage {
  id          String           @id @default(cuid())
  parrainId   String
  filleulId   String           @unique
  statut      StatutParrainage @default(EN_ATTENTE)
  valideLe    DateTime?
  createdAt   DateTime         @default(now())

  parrain Client @relation("Parrain", fields: [parrainId], references: [id], onDelete: Cascade)
  filleul Client @relation("Filleul", fields: [filleulId], references: [id], onDelete: Cascade)

  @@map("parrainages")
}

model Avis {
  id          String     @id @default(cuid())
  clientId    String
  note        Int
  commentaire String
  photoUrl    String?
  statut      StatutAvis @default(EN_ATTENTE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([statut])
  @@map("avis")
}

// ─── Marketing et réglages ───────────────

model Newsletter {
  id                 String   @id @default(cuid())
  email              String   @unique
  prenom             String?
  actif              Boolean  @default(true)
  consentementLe     DateTime @default(now())
  tokenDesinscription String  @unique @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("newsletter")
}

model QuizResult {
  id                 String         @id @default(cuid())
  clientId           String?
  email              String?
  accepteEmail       Boolean        @default(false)
  nomChien           String
  race               String?
  poids              Float
  ageMois            Int?
  taille             Taille
  niveauActivite     NiveauActivite
  estMacheur         Boolean        @default(false)
  allergenes         String[]
  allergiesAutres    String?
  sensibleTraces     Boolean        @default(false)
  formuleRecommandee TypeFormule
  createdAt          DateTime       @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("quiz_results")
}

model Contact {
  id        String   @id @default(cuid())
  clientId  String?
  prenom    String
  nom       String
  email     String
  sujet     String
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("contacts")
}

// Paramètres métier modifiables depuis le back-office
model Reglage {
  cle       String   @id
  valeur    Json
  updatedAt DateTime @updatedAt

  @@map("reglages")
}

// Événements Stripe déjà traités (idempotence du webhook)
model WebhookEvent {
  id        String   @id // id de l'événement Stripe
  type      String
  createdAt DateTime @default(now())

  @@map("webhook_events")
}
