# ─────────────────────────────────────────────────────────────
# .env.production — Dawky VPS Production
# Copiez en .env.production et remplissez les valeurs
# ⚠️  NE JAMAIS committer ce fichier sur Git !
# ─────────────────────────────────────────────────────────────

# ── Base de données Supabase ──────────────────────────────────
# Port 6543 = pgBouncer (pour l'app en production)
DATABASE_URL="postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Port 5432 = connexion directe (pour les migrations CLI)
DIRECT_URL="postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ─────────────────────────────────────────────
SUPABASE_URL="https://VOTRE_REF.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_KEY="eyJ..."

# ── Email via Resend ──────────────────────────────────────────
# Créez un compte sur resend.com → ajoutez dawky.fr comme domaine
# puis vérifiez les enregistrements DNS indiqués par Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="Dawky <contact@dawky.fr>"
EMAIL_REPLY_TO="contact@dawky.fr"

# ── Application ───────────────────────────────────────────────
APP_URL="https://dawky.fr"
NODE_ENV="production"

# ── Paiement Stripe ───────────────────────────────────────────
# Clés test (sk_test_...) en dev. Le secret webhook est fourni par
# `stripe listen --forward-to localhost:3000/api/webhooks/paiement` en local,
# ou par le dashboard Stripe (endpoint https://dawky.fr/api/webhooks/paiement).
# Événements à activer : checkout.session.completed, checkout.session.expired,
# invoice.paid, invoice.payment_failed, invoice.upcoming,
# customer.subscription.deleted
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Notifications internes (allergies à traiter, messages de contact)
EMAIL_EQUIPE="contact@dawky.fr"
