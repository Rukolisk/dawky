# ─────────────────────────────────────────
# DAWKY — Variables d'environnement
# ─────────────────────────────────────────

# ── PostgreSQL Runtime (pgBouncer pooler) ────────────────────────────────────
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── PostgreSQL Direct (migrations CLI) ───────────────────────────────────────
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_KEY="eyJ..."

# ── Email via Resend ──────────────────────────────────────────────────────────
# 1. Créez un compte gratuit sur https://resend.com
# 2. Ajoutez votre domaine Gmail ou créez une API key
# 3. Pour utiliser contact.dawky@gmail.com, vous devez soit :
#    a) Configurer un domaine custom sur Resend (recommandé en prod)
#    b) Utiliser l'adresse onboarding@resend.dev en développement
#
# RESEND_API_KEY : Dashboard Resend → API Keys → Create API Key
RESEND_API_KEY="re_..."

# Adresse expéditeur (doit être vérifiée dans Resend)
# En dev : utilisez "onboarding@resend.dev" ou "Dawky <contact@votredomaine.com>"
EMAIL_FROM="Dawky <contact.dawky@gmail.com>"
EMAIL_REPLY_TO="contact.dawky@gmail.com"

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Paiement Stripe ───────────────────────────────────────────
# Clés test (sk_test_...) en dev. Le secret webhook est fourni par
# `stripe listen --forward-to localhost:3000/api/webhooks/paiement` en local,
# ou par le dashboard Stripe (endpoint https://dawky.fr/api/webhooks/paiement).
# Événements à activer : checkout.session.completed, checkout.session.expired,
# invoice.paid, invoice.payment_failed, invoice.upcoming,
# customer.subscription.deleted
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Notifications internes (allergies à traiter, messages de contact)
EMAIL_EQUIPE="contact@dawky.fr"
